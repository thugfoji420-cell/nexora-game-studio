# Node / frontend
/node_modules/
/dist/

# Rust / Tauri build output
/src-tauri/target/

# Logs
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Local runtime/config data
/config/
.settings/
.runtime/
.cache/
tmp/
temp/

# Generated/local evidence and test artifacts
/phase6-real-provider-evidence/
/phase7-real-provider-evidence/

# Nexora-generated assets / models / jobs if ever created inside repo
/generated/
/processing/
/jobs/
*.glb
*.gltf
*.fbx
*.obj
*.ply
*.safetensors
*.ckpt
*.onnx

# Installers / packages
*.msi
*.exe
*.zip
*.7z

# Bundled llama.cpp engine (fetched from official llama.cpp releases, see
# docs/offline-self-coding.md). Never commit the 43 MB engine blob — the
# NSIS bundle pulls it from src-tauri/binaries/ at build time; teammates
# drop the release zip there themselves, or the build fails loudly.
/src-tauri/binaries/*.dll
/src-tauri/binaries/LICENSE-LLVM-OpenMP

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/

# Tauri generated schemas
/src-tauri/gen/
