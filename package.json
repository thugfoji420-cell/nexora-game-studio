{
  "name": "nexora-game-studio",
  "version": "0.2.10",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc && vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner && npm run test:rust",
    "test:js": "vitest run --configLoader runner",
    "test:rust": "python scripts/fix_test_manifest.py --run -- --lib",
    "test:rust:all": "python scripts/fix_test_manifest.py --run",
    "ci": "npm run typecheck && npm test && npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "health:ollama": "python scripts/health_check_ollama.py"
  },
  "dependencies": {
    "@respan/respan": "^2.5.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.175.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  }
}
