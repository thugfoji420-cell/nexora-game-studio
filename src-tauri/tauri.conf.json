{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora Game Studio",
  "version": "0.1.0",
  "identifier": "com.nexora.gamestudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexora Game Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' nexora-media: http://nexora-media.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Nexora visual production studio",
    "longDescription": "A local-first visual production studio foundation for Nexora games.",
    "copyright": "Copyright 2026 Nexora",
    "category": "DeveloperTool"
  }
}
